<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


    <joint name="camera_joint_left" type="fixed">
        <parent link="base_link"/>
        <child link="camera_frame_left"/>
        <origin xyz="0 0 1.3" rpy="0 0 0"/>
    </joint>

    <link name="camera_frame_left">
        <!-- <visual>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.06" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder> -->
    </link>







    <joint name="camera_optical_joint_joint" type="fixed">
        <parent link="camera_frame_left"/>
        <child link="camera_optical_left_link"/>
        <origin xyz="0 0.12 0" rpy="-1.5707 0 0"/>
    </joint>

    <link name="camera_optical_left_link">
        <visual>
            <geometry>
                <box size="0.4 0.03 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.03 0.02"/>
            </geometry>
        </collision>
    </link>


    <gazebo reference="camera_frame_left">
        <material>Gazebo/Blue</material>

        <sensor name="camera_left" type="depth">
            <pose>0.064 -0.065 0.094  0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                  <width>640</width>
                  <height>480</height>
                  <format>B8G8R8</format>
                </image>
                <clip>
                  <near>0.2</near>  <!-- Was 0.05, try 0.2 or 0.3 -->
                  <far>8.0</far>
                </clip>
            </camera>

            <plugin name="camera_left_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>camera_left</namespace>
                </ros>
                <frame_name>camera_optical_left_link</frame_name>
                <cameraName>camera_left</cameraName>
                <imageTopicName>image_raw</imageTopicName>
                <depthImageTopicName>depth/image_raw</depthImageTopicName>
                <pointCloudTopicName>points</pointCloudTopicName>
            </plugin>
        </sensor>
    </gazebo>

</robot>